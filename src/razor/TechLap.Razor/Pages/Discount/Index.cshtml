@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using TechLap.API.Enums
@model TechLap.Razor.Pages.Discount.IndexModel

@{
    ViewData["Title"] = "Manage Promotions";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<head>
    <link href="~/css/discount.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <title></title>
</head>

<div class="container-xl">
    <div class="table-responsive">
        <div class="table-wrapper">
            <div class="table-title">
                <div class="row">
                    <div class="col-sm-6">
                        <h2>Manage <b>Discounts</b></h2>
                    </div>
                    <div class="col-sm-6">
                        <a href="#addDiscountModal" class="btn btn-success" data-toggle="modal">
                            <i class="material-icons" style="vertical-align: middle; margin-right: 5px;">add</i>
                            <span>Add New Discount</span>
                        </a>
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <table class="table table-striped table-hover" id="discountTable">
                <thead>
                <tr>
                    <th>
                            <span class="custom-checkbox">
                                <input type="checkbox" id="selectAll">
                                <label for="selectAll"></label>
                            </span>
                    </th>
                    <th>ID</th>
                    <th>Discount Code</th>
                    <th>Discount Percentage</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Usage Limit</th>
                    <th>Times Used</th>
                    <th>Status</th>
                    <th>Create Date</th>
                </tr>
                </thead>
                <tbody id="discountTableBody">
                <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
            <div class="clearfix">
                <div class="hint-text" id="pagination-info">Showing <span id="currentPageEntries">0-0</span> of <span id="totalEntries">0</span> entries</div>
                <ul class="pagination justify-content-center" id="discountPagination">
                    <!-- Pagination will be generated dynamically -->
                </ul>
            </div>

            <!-- Loading indicator -->
            <div id="loadingIndicator" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Add Discount Modal -->
<div id="addDiscountModal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addDiscountForm">
                <div class="modal-header">
                    <h4 class="modal-title">Add New Discount</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Discount Code</label>
                        <input type="text" class="form-control" name="discountCode" required>
                    </div>
                    <div class="form-group">
                        <label>Discount Percentage</label>
                        <input type="text" class="form-control" name="discountPercentage" required>
                    </div>
                    <div class="form-group">
                        <label>Start Date</label>
                        <input type="date" class="form-control" name=">startDate" required>
                    </div>
                    <div class="form-group">
                        <label>End Date</label>
                        <input type="date" class="form-control" name="endDate">
                    </div>
                    <div class="form-group">
                        <label>Usage Limit</label>
                        <input type="number" class="form-control" name="usageLimit">
                    </div>
                    <div class="form-group">
                        <label>Times Used</label>
                        <input type="number" class="form-control" name="timesUsed">
                    </div>
                    <label for="status">Status</label>
                    <select class="form-control" name="status">
                        @foreach (var discountStatus in Enum.GetValues(typeof(DiscountStatus)))
                        {
                        <option value="@discountStatus">@discountStatus</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Discount Modal -->
<div id="editDiscountModal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editDiscountForm">
                <div class="modal-header">
                    <h4 class="modal-title">Edit Discount</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id">
                    <div class="form-group">
                        <label>Discount Code</label>
                        <input type="text" class="form-control" name="discountCode" required>
                    </div>
                    <div class="form-group">
                        <label>Discount Percentage</label>
                        <input type="text" class="form-control" name="discountPercentage" required>
                    </div>
                    <div class="form-group">
                        <label>Start Date</label>
                        <input type="date" class="form-control" name="startDate" required>
                    </div>
                    <div class="form-group">
                        <label>End Date</label>
                        <input type="date" class="form-control" name="endDate" required>
                    </div>
                    <div class="form-group">
                        <label>Usage Limit</label>
                        <input type="number" class="form-control" name="usageLimit">
                    </div>
                    <div class="form-group">
                        <label>Times Used</label>
                        <input type="number" class="form-control" name="timesUsed">
                    </div>
                    <div class="form-group">
                        <label>Status</label>
                        <select class="form-control" name="status">
                            @foreach (var discountStatus in Enum.GetValues(typeof(DiscountStatus)))
                            {
                            <option value="@discountStatus">@discountStatus</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    // Config ENV
    const API_ENDPOINT = '@Model.ApiEndpoint';
    const AUTH_TOKEN = '@Model.AuthToken';
    const PAGE_SIZE = 5;

    let currentPage = 1;
    let totalPages = 1;
    let totalEntries = 0;
    let selectedItems = [];

    // Khởi tạo khi trang được tải
    document.addEventListener('DOMContentLoaded', function () {
        setupCheckboxHandlers();
        loadDiscounts(1);

        // Xử lý form thêm sản phẩm
        document.getElementById('addDiscountForm').addEventListener('submit', function (e) {
            e.preventDefault();
            addDiscount();
        });

        // Xử lý form chỉnh sửa sản phẩm
        document.getElementById('editDiscountForm').addEventListener('submit', function (e) {
            e.preventDefault();
            saveEditedDiscount();
        });
    });

    // Thiết lập event handlers cho checkbox
    function setupCheckboxHandlers() {
        const selectAllCheckbox = document.getElementById('selectAll');

        selectAllCheckbox.addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('input[type="checkbox"][name="options[]"]');
            checkboxes.forEach(function (checkbox) {
                checkbox.checked = selectAllCheckbox.checked;

                const discountId = checkbox.value;
                if (selectAllCheckbox.checked) {
                    if (!selectedItems.includes(discountId)) {
                        selectedItems.push(discountId);
                    }
                } else {
                    selectedItems = selectedItems.filter(id => id !== discountId);
                }
            });

            updateSelectedCount();
        });

        document.addEventListener('click', function (e) {
            if (e.target && e.target.type === 'checkbox' && e.target.name === 'options[]') {
                const discountId = e.target.value;
                if (e.target.checked) {
                    if (!selectedItems.includes(discountId)) {
                        selectedItems.push(discountId);
                    }
                } else {
                    selectedItems = selectedItems.filter(id => id !== discountId);
                    document.getElementById('selectAll').checked = false;
                }

                updateSelectedCount();
            }
        });
    }

    // Cập nhật số lượng mục đã chọn
    function updateSelectedCount() {
        const hintText = document.querySelector('.hint-text');
        if (totalEntries > 0) {
            hintText.innerHTML = `Showing <span id="currentPageEntries">${document.getElementById('currentPageEntries').textContent}</span> of <span id="totalEntries">${totalEntries}</span> entries`;
        }
    }

    // Load danh sách sản phẩm
    function loadDiscounts(page) {
        currentPage = page;
        const skip = (page - 1) * PAGE_SIZE;

        document.getElementById('loadingIndicator').style.display = 'block';

        // const odataQuery = `$top=${PAGE_SIZE}&$skip=${skip}&$orderby=id desc`;
        const odataQuery = `$top=${PAGE_SIZE}&$skip=${skip}&$count=true&$orderby=id desc`;


        fetch(`${API_ENDPOINT}/api/discounts?${odataQuery}`, {
            method: 'GET',
            headers: {
                'Authorization': `Bearer ${AUTH_TOKEN}`,
                'Content-Type': 'application/json',
                'Accept': '*/*'
            }
        })
            .then(response => {
                if (!response.ok) {
                    if (response.status === 401) {
                        window.location.href = '/Login/Index';
                    }
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                let discounts = [];

                if (Array.isArray(data)) {
                    discounts = data;
                } else if (data.isSuccess && Array.isArray(data.data)) {
                    discounts = data.data;
                } else {
                    throw new Error('Unexpected data structure: ' + JSON.stringify(data));
                }

                let count = data.totalCount || data.count || (discounts.length === PAGE_SIZE ? (page * PAGE_SIZE) + PAGE_SIZE : (page - 1) * PAGE_SIZE + discounts.length);
                if (!count) {
                    const hasMoreData = discounts.length === PAGE_SIZE;
                    count = hasMoreData ? (page * PAGE_SIZE) + PAGE_SIZE : (page - 1) * PAGE_SIZE + discounts.length;
                }

                totalEntries = count;
                totalPages = Math.ceil(totalEntries / PAGE_SIZE);

                displayDiscounts(discounts);
            })
            .catch(error => {
                console.error('Error loading discounts:', error);
                displayErrorMessage('Failed to load discounts: ' + error.message);
            })
            .finally(() => {
                document.getElementById('loadingIndicator').style.display = 'none';
            });
    }

    // Hiển thị danh sách sản phẩm
    function displayDiscounts(discounts) {
        const tableBody = document.getElementById('discountTableBody');
        tableBody.innerHTML = '';

        if (!discounts || discounts.length === 0) {
            tableBody.innerHTML = `
            <tr>
                <td colspan="10" style="text-align:center;">There are no discounts to display</td>
            </tr>
        `;
            updatePaginationInfo(0, 0);
        } else {
            discounts.forEach(discount => {
                const row = document.createElement('tr');
                row.innerHTML = `
                <td>
                    <span class="custom-checkbox">
                        <input type="checkbox" id="checkbox${discount.id}" name="options[]" value="${discount.id}" ${selectedItems.includes(discount.id) ? 'checked' : ''}>
                        <label for="checkbox${discount.id}"></label>
                    </span>
                </td>
                <td>${discount.id}</td>
                <td>${discount.discountCode || 'N/A'}</td>
                <td>${discount.discountPercentage || 0}</td>
                <td>${discount.startDate ? new Date(discount.startDate).toLocaleDateString() : 'N/A'}</td>
                <td>${discount.endDate ? new Date(discount.endDate).toLocaleDateString() : 'N/A'}</td>
                <td>${discount.usageLimit || 0}</td>
                <td>${discount.timesUsed || 0}</td>
                <td>${discount.status || 'N/A'}</td>
                <td>
                    <a href="javascript:void(0)" onclick="openEditDiscountModal(${discount.id})" class="edit">
                        <i class="material-icons" data-toggle="tooltip" title="Edit"></i>
                    </a>
                    <a href="javascript:void(0)" onclick="deleteDiscount(${discount.id})">
                        <i class="material-icons" data-toggle="tooltip" title="Delete"></i>
                    </a>
                </td>
            `;
                tableBody.appendChild(row);
            });

            const start = (currentPage - 1) * PAGE_SIZE + 1;
            const end = Math.min(start + discounts.length - 1, totalEntries);
            updatePaginationInfo(start, end);
        }

        updatePagination();
    }

    // Thêm sản phẩm mới
    function addDiscount() {
        const form = document.getElementById('addDiscountForm');
        const formData = {
            discountCode: form.querySelector('[name="discountCode"]').value,
            discountPercentage: form.querySelector('[name="discountPercentage"]').value,
            startDate: form.querySelector('[name="startDate"]').value,
            endDate: form.querySelector('[name="endDate"]').value || null,
            usageLimit: form.querySelector('[name="usageLimit"]').value || null,
            timesUsed: form.querySelector('[name="timesUsed"]').value || null,
            screenSize: form.querySelector('[name="screenSize"]').value || null,
            status: form.querySelector('[name="status"]').value || null
        };

        fetch(`${API_ENDPOINT}/api/discounts/create`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${AUTH_TOKEN}`,
                'Content-Type': 'application/json;odata.metadata=minimal;odata.streaming=true',
                'Accept': '*/*'
            },
            body: JSON.stringify(formData)
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.isSuccess) {
                    $('#addDiscountModal').modal('hide');
                    form.reset();
                    loadDiscounts(currentPage);
                } else {
                    alert('Failed to add discount: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error adding discount:', error);
                alert('An error occurred while adding the discount.');
            });
    }

    // Mở modal chỉnh sửa sản phẩm và điền dữ liệu
    function openEditDiscountModal(discountId) {
        fetch(`${API_ENDPOINT}/api/discounts/${discountId}`, {
            method: 'GET',
            headers: {
                'Authorization': `Bearer ${AUTH_TOKEN}`,
                'Accept': '*/*'
            }
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                const discount = data.isSuccess ? data.data : data;
                const form = document.getElementById('editDiscountForm');
                form.querySelector('[name="id"]').value = discount.id || '';
                form.querySelector('[name="discountCode"]').value = discount.discountCode || '';
                form.querySelector('[name="discountPercentage"]').value = discount.discountPercentage || 0;
                form.querySelector('[name="startDate"]').value = discount.startDate || '';
                form.querySelector('[name="endDate"]').value = discount.endDate || '';
                form.querySelector('[name="usageLimit"]').value = discount.usageLimit || 0;
                form.querySelector('[name="timesUsed"]').value = discount.timesUsed || 0;
                form.querySelector('[name="status"]').value = discount.status || '';
            

                $('#editDiscountModal').modal('show');
            })
            .catch(error => {
                console.error('Error fetching discount:', error);
                alert('An error occurred while loading the discount data.');
            });
    }

    // Lưu sản phẩm đã chỉnh sửa
    function saveEditedDiscount() {
        const form = document.getElementById('editDiscountForm');
        const discountId = form.querySelector('[name="id"]').value;
        const formData = {
            id: parseInt(discountId),
            discountCode: form.querySelector('[name="discountCode"]').value,
            discountPercentage: form.querySelector('[name="discountPercentage"]').value,
            startDate: form.querySelector('[name="startDate"]').value,
            endDate: form.querySelector('[name="endDate"]').value || null,
            usageLimit: form.querySelector('[name="usageLimit"]').value || null,
            timesUsed: form.querySelector('[name="timesUsed"]').value || null
        };

        fetch(`${API_ENDPOINT}/api/discounts/${discountId}`, {
            method: 'PUT',
            headers: {
                'Authorization': `Bearer ${AUTH_TOKEN}`,
                'Content-Type': 'application/json;odata.metadata=minimal;odata.streaming=true',
                'Accept': '*/*'
            },
            body: JSON.stringify(formData)
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.isSuccess) {
                    $('#editDiscountModal').modal('hide');
                    loadDiscounts(currentPage);
                } else {
                    alert('Failed to update discout: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error updating discout:', error);
                alert('An error occurred while updating the discout.');
            });
    }

    // Xóa sản phẩm
    function deleteDiscount(discountId) {
        if (confirm('Are you sure you want to delete this discount?')) {
            fetch(`${API_ENDPOINT}/api/discounts/${discountId}`, {
                method: 'DELETE',
                headers: {
                    'Authorization': `Bearer ${AUTH_TOKEN}`,
                    'Accept': '*/*'
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.isSuccess) {
                        loadDiscounts(currentPage);
                        selectedItems = selectedItems.filter(id => id !== String(discountId));
                        updateSelectedCount();
                    } else {
                        alert('Failed to delete discount: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error deleting discount:', error);
                    alert('An error occurred while deleting the discount.');
                });
        }
    }

    // Cập nhật thông tin phân trang
    function updatePaginationInfo(start, end) {
        document.getElementById('currentPageEntries').textContent = `${start}-${end}`;
        document.getElementById('totalEntries').textContent = totalEntries;
    }

    // Cập nhật UI phân trang
    function updatePagination() {
        const pagination = document.getElementById('discountPagination');
        pagination.innerHTML = '';

        // Nút Previous
        const prevButton = document.createElement('li');
        prevButton.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
        prevButton.innerHTML = `<a class="page-link" href="javascript:void(0)" ${currentPage > 1 ? 'onclick="loadDiscounts(' + (currentPage - 1) + ')"' : ''}>Previous</a>`;
        pagination.appendChild(prevButton);

        // Các nút số trang
        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, startPage + 4);

        for (let i = startPage; i <= endPage; i++) {
            const pageButton = document.createElement('li');
            pageButton.className = `page-item ${i === currentPage ? 'active' : ''}`;
            pageButton.innerHTML = `<a class="page-link" href="javascript:void(0)" onclick="loadDiscounts(${i})">${i}</a>`;
            pagination.appendChild(pageButton);
        }

        // Nút Next
        const nextButton = document.createElement('li');
        nextButton.className = `page-item ${currentPage >= totalPages ? 'disabled' : ''}`;
        nextButton.innerHTML = `<a class="page-link" href="javascript:void(0)" ${currentPage < totalPages ? 'onclick="loadDiscounts(' + (currentPage + 1) + ')"' : ''}>Next</a>`;
        pagination.appendChild(nextButton);
    }

    // Hiển thị thông báo lỗi
    function displayErrorMessage(message) {
        const tableBody = document.getElementById('discountTableBody');
        tableBody.innerHTML = `
            <tr>
                <td colspan="10" style="text-align:center; color: red;">
                    ${message}
                </td>
            </tr>
        `;

        document.getElementById('discountPagination').innerHTML = '';
        updatePaginationInfo(0, 0);
    }
</script>